<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>observable_model</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>TopLevel</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>import Observation

@Observable
final class &lt;#Name#&gt;Model {
    var &lt;#property#&gt;: &lt;#Type#&gt; = &lt;#defaultValue#&gt;

    @ObservationIgnored
    private let &lt;#dependency#&gt;: &lt;#DependencyType#&gt;

    init(&lt;#dependency#&gt;: &lt;#DependencyType#&gt;) {
        self.&lt;#dependency#&gt; = &lt;#dependency#&gt;
    }
}</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>586C9CD4-FF70-4AB9-B146-A3349E57D3BA</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>An @Observable model with ignored dependencies.</string>
	<key>IDECodeSnippetTitle</key>
	<string>Observable Model</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
