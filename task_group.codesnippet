<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string>task_group</string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>CodeBlock</string>
		<string>CodeExpression</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>try await withThrowingTaskGroup(of: &lt;#ChildResult#&gt;.self) { group in
    for &lt;#item#&gt; in &lt;#items#&gt; {
        group.addTask {
            try await &lt;#work#&gt;
        }
    }
    var results: [&lt;#ChildResult#&gt;] = []
    for try await result in group {
        results.append(result)
    }
    return results
}</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>288DF957-C0E5-4E86-8CAD-E6AB2FB32766</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>Run child tasks concurrently and collect their results.</string>
	<key>IDECodeSnippetTitle</key>
	<string>Throwing Task Group</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
